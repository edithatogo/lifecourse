  "decision_problem": {
    "id": "genomic-testing-policy",
    "description": "Example genomic testing intervention comparison.",
    "strategies": [
      {
        "id": "base",
        "name": "Current practice"
      },
      {
        "id": "prospective_testing",
        "name": "Prospective genomic testing"
      }
    ]
