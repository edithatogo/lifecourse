{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edithatogo.github.io/heoml/schemas/v0.1/manifest.schema.json",
  "title": "HEOML v0.1 Run Bundle Manifest",
  "type": "object",
  "required": [
    "heoml_version",
    "profile",
    "producer",
    "model",
    "run",
    "decision_problem",
    "artifacts"
  ],
  "properties": {
    "heoml_version": {
      "type": "string",
      "const": "0.1"
    },
    "profile": {
      "type": "string",
      "const": "heoml.run_bundle"
    },
    "producer": {
      "type": "object",
      "required": ["package", "version"],
      "properties": {
        "package": {"type": "string"},
        "version": {"type": "string"},
        "git_revision": {"type": ["string", "null"]},
        "created_at": {"type": "string"}
      },
      "additionalProperties": true
    },
    "model": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "type": {"type": "string"},
        "cohort": {"type": ["string", "null"]},
        "simulation_engine": {"type": ["string", "null"]},
        "simulation_engine_version": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "run": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string"},
        "scenario_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "seed_policy": {"type": ["string", "null"]},
        "time_horizon_years": {"type": ["number", "null"]},
        "discount_rate": {"type": ["number", "null"]},
        "wtp_thresholds": {
          "type": "array",
          "items": {"type": "number"}
        }
      },
      "additionalProperties": true
    },
    "decision_problem": {
      "type": "object",
      "required": ["id", "strategies"],
      "properties": {
        "id": {"type": "string"},
        "description": {"type": ["string", "null"]},
        "strategies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": {"type": "string"},
              "name": {"type": "string"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "path", "media_type"],
        "properties": {
          "id": {"type": "string"},
          "category": {
            "type": "string",
            "enum": [
              "input",
              "parameter",
              "scenario",
              "outcome",
              "psa",
              "voi",
              "figure",
              "diagnostic",
              "report"
            ]
          },
          "path": {"type": "string"},
          "media_type": {"type": "string"},
          "schema_ref": {"type": ["string", "null"]},
          "checksum": {"type": ["string", "null"]},
          "description": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["level", "message"],
        "properties": {
          "level": {
            "type": "string",
            "enum": ["info", "warning", "error"]
          },
          "message": {"type": "string"},
          "code": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
